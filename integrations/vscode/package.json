{
  "name": "smartroute-vscode",
  "displayName": "SmartRoute (IAIso)",
  "version": "3.0.0",
  "description": "Gate one agent tool-access request: return an allow/block decision with a 0..1 trust score and the ROUTE-* signals that moved it.",
  "publisher": "smarttasks",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:smartroute.run"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartroute.run",
        "title": "SmartRoute: Run on current file/workspace"
      }
    ],
    "configuration": {
      "title": "SmartRoute",
      "properties": {
        "smartroute.python": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter"
        }
      }
    }
  }
}